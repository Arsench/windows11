<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta clara. Mismas claves que la oscura: cambiar de tema es sustituir este diccionario. -->

    <Color x:Key="ZenithAccentColor">#4C63D2</Color>
    <Color x:Key="ZenithAccentSoftColor">#1F4C63D2</Color>
    <Color x:Key="ZenithSuccessColor">#0F8A50</Color>
    <Color x:Key="ZenithWarningColor">#B96A08</Color>
    <Color x:Key="ZenithDangerColor">#C42B31</Color>

    <SolidColorBrush x:Key="ZenithAccentBrush" Color="#4C63D2" />
    <SolidColorBrush x:Key="ZenithAccentHoverBrush" Color="#3F55C4" />
    <SolidColorBrush x:Key="ZenithAccentPressedBrush" Color="#354AB0" />
    <SolidColorBrush x:Key="ZenithAccentSubtleBrush" Color="#1A4C63D2" />
    <SolidColorBrush x:Key="ZenithOnAccentBrush" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="ZenithTextPrimaryBrush" Color="#E4000000" />
    <SolidColorBrush x:Key="ZenithTextSecondaryBrush" Color="#A3000000" />
    <SolidColorBrush x:Key="ZenithTextTertiaryBrush" Color="#78000000" />
    <SolidColorBrush x:Key="ZenithTextDisabledBrush" Color="#4D000000" />

    <SolidColorBrush x:Key="ZenithSurfaceBrush" Color="#8AFFFFFF" />
    <SolidColorBrush x:Key="ZenithCardBrush" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="ZenithCardHoverBrush" Color="#D6FFFFFF" />
    <SolidColorBrush x:Key="ZenithCardStrokeBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ZenithDividerBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="ZenithSubtleHoverBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="ZenithSubtlePressedBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ZenithTrackBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ZenithScrimBrush" Color="#59000000" />

    <SolidColorBrush x:Key="ZenithSuccessBrush" Color="#0F8A50" />
    <SolidColorBrush x:Key="ZenithWarningBrush" Color="#B96A08" />
    <SolidColorBrush x:Key="ZenithDangerBrush" Color="#C42B31" />

    <SolidColorBrush x:Key="ZenithChartStrokeBrush" Color="#4C63D2" />
    <LinearGradientBrush x:Key="ZenithChartFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4C4C63D2" />
        <GradientStop Offset="1" Color="#004C63D2" />
    </LinearGradientBrush>

</ResourceDictionary>
