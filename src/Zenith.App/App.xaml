<Application x:Class="Zenith.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Zenith.App.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Zenith.App.Views"
             xmlns:vm="clr-namespace:Zenith.App.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    El índice 0 es la paleta: ThemeService la sustituye en caliente
                    al cambiar entre claro y oscuro.
                -->
                <ResourceDictionary Source="pack://application:,,,/Resources/Palette.Dark.xaml" />
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="pack://application:,,,/Resources/Tokens.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:InverseBooleanConverter x:Key="InverseBoolean" />

            <!-- Enlace ViewModel → Vista: la navegación es por tipo, no por URL. -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SystemViewModel}">
                <views:SystemPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StorageViewModel}">
                <views:StoragePage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}">
                <views:DuplicatesPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsPage />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
