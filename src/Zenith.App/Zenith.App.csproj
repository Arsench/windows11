<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatform>windows10.0.19041.0</SupportedOSPlatform>
    <UseWPF>true</UseWPF>
    <RootNamespace>Zenith.App</RootNamespace>
    <AssemblyName>Zenith</AssemblyName>
    <ApplicationIcon>Assets\zenith.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zenith.Core\Zenith.Core.csproj" />
    <ProjectReference Include="..\Zenith.Platform.Windows\Zenith.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <!--
      Toda la familia Serilog en la misma versión mayor. Los sinks 6.x y 3.x exigen
      Serilog 4.x, mientras que Serilog.Extensions.Hosting 8.0.0 está compilado
      contra Serilog 3.x: NuGet lo resolvería subiendo a 4.x sin avisar y mezclando
      versiones mayores. Estas versiones se quedan todas en Serilog 3.1.1.
    -->
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="2.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\zenith.ico" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Los avisos de terceros viajan junto al ejecutable: es un requisito de las
      licencias MIT, Apache-2.0 y MPL-2.0, y la pantalla de Licencia los abre
      desde aquí.
    -->
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
