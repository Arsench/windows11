<UserControl x:Class="Zenith.App.Views.StoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Zenith.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:storage="clr-namespace:Zenith.Core.Storage;assembly=Zenith.Core"
             xmlns:vm="clr-namespace:Zenith.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StorageViewModel}">

    <UserControl.Resources>
        <!-- Tarjeta de unidad seleccionable: es la tarjeta y el control a la vez. -->
        <Style x:Key="VolumeCardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ZenithFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Padding="18"
                                Background="{DynamicResource ZenithCardBrush}"
                                BorderBrush="{DynamicResource ZenithCardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ZenithRadiusCard}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ZenithCardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ZenithAccentBrush}" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="1.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,0,32,32">

            <!-- ===================== Unidades ===================== -->
            <ListBox Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource VolumeCardItem}"
                     ItemsSource="{Binding Volumes}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectedItem="{Binding SelectedVolume, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:AdaptiveGridPanel MinItemWidth="250" Gap="16" MaxColumns="4" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:VolumeViewModel}">
                        <Grid AutomationProperties.Name="{Binding AccessibleName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="62" Height="62" VerticalAlignment="Top">
                                <controls:RadialGauge RingThickness="6"
                                                      TrackBrush="{DynamicResource ZenithTrackBrush}"
                                                      Value="{Binding UsagePercent}"
                                                      ValueBrush="{DynamicResource ZenithAccentBrush}" />
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{StaticResource ZenithDisplayFont}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ZenithTextPrimaryBrush}"
                                           Text="{Binding UsagePercentText}" />
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ZenithSubtitleText}" Text="{Binding DriveLetter}" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                               Style="{StaticResource ZenithCaptionText}"
                                               Text="{Binding Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource ZenithBodyText}" Text="{Binding UsagePairText}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource ZenithCaptionText}" Text="{Binding FreeText}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource ZenithCaptionText}"
                                           Text="{Binding DetailsText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ===================== Analizador ===================== -->
            <Border Style="{StaticResource ZenithCard}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource ZenithSubtitleText}" Text="¿En qué se está yendo el espacio?" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource ZenithBodyText}"
                                       Text="Analiza una unidad o una carpeta concreta. Puedes cancelar en cualquier momento." />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <Button Command="{Binding AnalyzeFolderCommand}"
                                    Content="Elegir carpeta…"
                                    Style="{StaticResource ZenithSecondaryButton}" />
                            <Button Margin="10,0,0,0"
                                    Command="{Binding AnalyzeVolumeCommand}"
                                    Content="Analizar unidad"
                                    Style="{StaticResource ZenithPrimaryButton}" />
                        </StackPanel>
                    </Grid>

                    <!-- Progreso -->
                    <Border Margin="0,18,0,0" Padding="16"
                            Background="{DynamicResource ZenithSubtleHoverBrush}"
                            CornerRadius="{StaticResource ZenithRadiusMedium}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource ZenithBodyStrongText}" Text="Analizando…" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource ZenithCaptionText}"
                                           Text="{Binding ScanTargetText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource ZenithBodyText}" Text="{Binding ScanStatusText}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Command="{Binding CancelScanCommand}"
                                    Content="Cancelar"
                                    Style="{StaticResource ZenithSecondaryButton}" />
                        </Grid>
                    </Border>

                    <!-- Resultado -->
                    <StackPanel Margin="0,18,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource ZenithBodyStrongText}" Text="{Binding ScanSummaryText}" />

                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource ZenithCaptionText}"
                                   Visibility="{Binding SkippedCount, Converter={StaticResource EmptyToVisibility}}">
                            <Run Text="Se han omitido" />
                            <Run Text="{Binding SkippedCount, Mode=OneWay}" />
                            <Run Text="ubicaciones por falta de permisos o por estar en uso." />
                        </TextBlock>

                        <!-- Miga de pan -->
                        <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Breadcrumb}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type storage:FolderNode}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.NavigateBreadcrumbCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding Name}"
                                                Padding="8,4"
                                                Style="{StaticResource ZenithSubtleButton}" />
                                        <TextBlock Margin="2,0" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource ZenithIconFont}" FontSize="10"
                                                   Foreground="{DynamicResource ZenithTextTertiaryBrush}"
                                                   Text="&#xE76C;" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Carpetas -->
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FolderEntryViewModel}">
                                    <Button Margin="0,2"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.DrillDownCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ZenithSubtleButton}"
                                            Padding="12,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Style="{StaticResource ZenithBodyText}"
                                                       Foreground="{DynamicResource ZenithTextPrimaryBrush}"
                                                       Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="1" Margin="12,0" MinWidth="60" TextAlignment="Right"
                                                       Style="{StaticResource ZenithCaptionText}" Text="{Binding PercentText}" />
                                            <TextBlock Grid.Column="2" MinWidth="80" TextAlignment="Right"
                                                       Style="{StaticResource ZenithBodyStrongText}" Text="{Binding SizeText}" />

                                            <controls:UsageBar Grid.Row="1" Grid.ColumnSpan="3"
                                                               Height="4" Margin="0,8,0,0"
                                                               TrackBrush="{DynamicResource ZenithTrackBrush}"
                                                               Value="{Binding Percent}"
                                                               ValueBrush="{DynamicResource ZenithAccentBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Tipos de archivo y archivos grandes -->
                        <controls:AdaptiveGridPanel Margin="0,20,0,0" MinItemWidth="320" Gap="16" MaxColumns="2">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ZenithBodyStrongText}" Text="Por tipo de archivo" />
                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Categories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CategoryEntryViewModel}">
                                            <Grid Margin="0,0,0,12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource ZenithBodyText}" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource ZenithBodyStrongText}" Text="{Binding SizeText}" />
                                                <controls:UsageBar Grid.Row="1" Grid.ColumnSpan="2" Height="4" Margin="0,6,0,0"
                                                                   TrackBrush="{DynamicResource ZenithTrackBrush}"
                                                                   Value="{Binding Percent}"
                                                                   ValueBrush="{DynamicResource ZenithAccentBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Style="{StaticResource ZenithBodyStrongText}" Text="Archivos más grandes" />
                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding LargestFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LargeFileViewModel}">
                                            <Button Margin="0,1" HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.RevealFileCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="8,8"
                                                    Style="{StaticResource ZenithSubtleButton}"
                                                    ToolTip="{Binding Path}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource ZenithBodyText}"
                                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                               Style="{StaticResource ZenithBodyStrongText}" Text="{Binding SizeText}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </controls:AdaptiveGridPanel>
                    </StackPanel>

                    <controls:EmptyState Glyph="&#xE721;"
                                         Title="Todavía no has analizado nada"
                                         Message="Elige una unidad arriba y pulsa «Analizar unidad», o selecciona una carpeta concreta."
                                         Visibility="{Binding ShowAnalyzerPlaceholder, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
