<UserControl x:Class="Zenith.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Zenith.App.Controls"
             xmlns:loc="clr-namespace:Zenith.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Zenith.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,0,32,32">

            <!-- Saludo -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Style="{StaticResource ZenithDisplayText}" Text="{Binding Greeting}" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource ZenithBodyText}"
                           Text="{Binding MachineSummary}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Métricas en vivo -->
            <controls:AdaptiveGridPanel MinItemWidth="230" Gap="16" MaxColumns="4">
                <controls:MetricTile Label="PROCESADOR"
                                     Value="{Binding CpuValueText}"
                                     Secondary="{Binding CpuSecondaryText}"
                                     Percent="{Binding CpuUsage}"
                                     History="{Binding CpuHistory}" />

                <controls:MetricTile Label="MEMORIA"
                                     Value="{Binding MemoryValueText}"
                                     Secondary="{Binding MemorySecondaryText}"
                                     Percent="{Binding MemoryUsage}"
                                     History="{Binding MemoryHistory}" />

                <controls:MetricTile Label="GRÁFICA"
                                     Value="{Binding GpuValueText}"
                                     Secondary="{Binding GpuSecondaryText}"
                                     Percent="{Binding GpuUsage}"
                                     History="{Binding GpuHistory}" />

                <controls:MetricTile Label="TEMPERATURA"
                                     Value="{Binding TemperatureValueText}"
                                     Secondary="{Binding TemperatureSecondaryText}"
                                     ShowChart="False" />
            </controls:AdaptiveGridPanel>

            <!-- Almacenamiento -->
            <Border Style="{StaticResource ZenithCard}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource ZenithSubtitleText}" Text="{loc:T DashboardStorage}" />
                        <Button HorizontalAlignment="Right"
                                Command="{Binding RefreshVolumesCommand}"
                                Style="{StaticResource ZenithSubtleButton}"
                                ToolTip="{loc:T DashboardRefreshDrives}"
                                AutomationProperties.Name="{loc:T DashboardRefreshDrives}">
                            <TextBlock FontFamily="{StaticResource ZenithIconFont}" FontSize="14" Text="&#xE72C;" />
                        </Button>
                    </Grid>

                    <!-- Esqueleto de carga: la tarjeta no salta de vacío a lleno. -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding IsLoadingVolumes, Converter={StaticResource BoolToVisibility}}">
                        <Border Height="14" Margin="0,0,0,10" Width="180" HorizontalAlignment="Left"
                                Background="{DynamicResource ZenithTrackBrush}" CornerRadius="7" />
                        <Border Height="6" Background="{DynamicResource ZenithTrackBrush}" CornerRadius="3" />
                    </StackPanel>

                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Volumes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VolumeViewModel}">
                                <Grid Margin="0,12,0,0" AutomationProperties.Name="{Binding AccessibleName}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource ZenithBodyStrongText}"
                                               Text="{Binding DriveLetter}" />

                                    <TextBlock Grid.Column="1" Margin="12,0,12,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource ZenithCaptionText}"
                                               Text="{Binding DetailsText}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />

                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource ZenithBodyText}"
                                               Text="{Binding UsagePairText}" />

                                    <controls:UsageBar Grid.Row="1" Grid.ColumnSpan="3"
                                                       Height="6" Margin="0,8,0,0"
                                                       TrackBrush="{DynamicResource ZenithTrackBrush}"
                                                       Value="{Binding UsagePercent}">
                                        <controls:UsageBar.Style>
                                            <Style TargetType="controls:UsageBar">
                                                <Setter Property="ValueBrush" Value="{DynamicResource ZenithAccentBrush}" />
                                                <Style.Triggers>
                                                    <!-- Por encima del 90 % la unidad empieza a ser un problema. -->
                                                    <DataTrigger Binding="{Binding IsNearlyFull}" Value="True">
                                                        <Setter Property="ValueBrush" Value="{DynamicResource ZenithWarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:UsageBar.Style>
                                    </controls:UsageBar>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <controls:EmptyState Glyph="&#xEDA2;"
                                         Title="{loc:T DashboardNoDrivesTitle}"
                                         Message="{loc:T DashboardNoDrivesMessage}"
                                         Visibility="{Binding ShowNoVolumes, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
