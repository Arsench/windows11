<UserControl x:Class="Zenith.App.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="0,48"
                DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

        <Border Width="64" Height="64"
                HorizontalAlignment="Center"
                Background="{DynamicResource ZenithSubtleHoverBrush}"
                CornerRadius="20">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{StaticResource ZenithIconFont}"
                       FontSize="26"
                       Foreground="{DynamicResource ZenithTextTertiaryBrush}"
                       Text="{Binding Glyph}" />
        </Border>

        <TextBlock Margin="0,20,0,0"
                   HorizontalAlignment="Center"
                   Style="{StaticResource ZenithSubtitleText}"
                   Text="{Binding Title}" />

        <TextBlock MaxWidth="420" Margin="0,8,0,0"
                   HorizontalAlignment="Center"
                   Style="{StaticResource ZenithBodyText}"
                   Text="{Binding Message}"
                   TextAlignment="Center" />

        <ContentPresenter Margin="0,20,0,0"
                          HorizontalAlignment="Center"
                          Content="{Binding Action}" />
    </StackPanel>
</UserControl>
